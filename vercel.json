{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "redirects": [
    { "source": "/learn", "destination": "/results-and-resources", "permanent": true },
    { "source": "/learn/:slug", "destination": "/results-and-resources/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
